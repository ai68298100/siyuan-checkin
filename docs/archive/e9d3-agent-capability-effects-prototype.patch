+/** Effects declared by a capability. The host uses these flags to decide whether
+ * a user confirmation is required before invoking it. */
+export interface AgentCapabilityEffects {
+    localRead?: boolean;
+    localWrite?: boolean;
+    dataEgress?: boolean;
+    externalCost?: boolean;
+    requiresConfirmation?: boolean;
+}
+
+/** A capability that only reads local data and can safely be exposed by default. */
+export interface ReadonlyAgentCapability {
+    name: string;
+    effects: AgentCapabilityEffects;
+}
+
+export const AGENT_CAPABILITY_VERSION = 1;
+
+export function isReadonlyAgentCapability(capability: Partial<ReadonlyAgentCapability> | undefined): boolean {
+    return Boolean(capability?.name && capability.effects?.localRead === true && capability.effects.localWrite !== true);
+}
+
+/** Require an explicit user acknowledgement for every local write. */
+export function requireAgentConfirmation(args: Record<string, unknown>, field = "confirmed"): {ok: true} | {ok: false; error: string} {
+    return args[field] === true
+        ? {ok: true}
+        : {ok: false, error: "此操作会修改本地打卡数据，请先取得用户明确确认（confirmed: true）。"};
+}
+
 export interface AgentCapabilityProbe {
     supported: boolean;
     register: (options: unknown) => {registered: boolean; error?: string};
